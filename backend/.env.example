# ---------- Application ----------
APP_NAME=Saarthi
APP_ENV=development
DEBUG=True

# ---------- Database ----------
# Supabase dashboard → Project Settings → Database → Connection string (URI)
# If your password contains @ : / # ? & you MUST URL-encode them (@ -> %40, : -> %3A, etc.)
DATABASE_URL=postgresql://postgres:<YOUR-DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres

# ---------- JWT / Auth ----------
SECRET_KEY=replace-with-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- LLM (used from Phase 4 onward) ----------
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Supabase Storage (Phase 2 — KYC media) ----------
# Both values: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# IMPORTANT: this is the SERVICE ROLE key, NOT the anon key. Server-only. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kyc-media

# ---------- CORS ----------
FRONTEND_URL=http://localhost:5173
